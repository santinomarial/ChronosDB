if(NOT DEFINED COMPILE_COMMANDS OR NOT EXISTS "${COMPILE_COMMANDS}")
  message(FATAL_ERROR "compile_commands.json is required to verify UBSan configuration")
endif()
if(NOT DEFINED SOURCE_ROOT)
  message(FATAL_ERROR "SOURCE_ROOT is required to identify ChronosDB-owned targets")
endif()

file(READ "${COMPILE_COMMANDS}" compile_commands)
string(JSON command_count LENGTH "${compile_commands}")
math(EXPR last_command "${command_count} - 1")
set(checked_commands 0)

foreach(command_index RANGE "${last_command}")
  string(JSON source_file GET "${compile_commands}" "${command_index}" file)
  cmake_path(IS_PREFIX SOURCE_ROOT "${source_file}" NORMALIZE is_project_source)
  if(NOT is_project_source OR source_file MATCHES "/build/")
    continue()
  endif()

  string(JSON command GET "${compile_commands}" "${command_index}" command)
  string(FIND "${command}" "-fno-sanitize-recover=undefined" flag_offset)
  if(flag_offset EQUAL -1)
    message(FATAL_ERROR "ChronosDB UBSan source permits recovery: ${source_file}")
  endif()
  math(EXPR checked_commands "${checked_commands} + 1")
endforeach()

if(checked_commands EQUAL 0)
  message(FATAL_ERROR "No ChronosDB-owned compile commands were checked")
endif()
