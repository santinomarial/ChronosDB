@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(CURL 7.75)
set(ChronosDB_CURL_VERSION "${CURL_VERSION}")
if(ChronosDB_CURL_VERSION STREQUAL "")
  set(ChronosDB_CURL_VERSION "${CURL_VERSION_STRING}")
endif()
if(ChronosDB_CURL_VERSION VERSION_GREATER_EQUAL 9.0)
  set(ChronosDB_FOUND FALSE)
  set(ChronosDB_NOT_FOUND_MESSAGE
      "ChronosDB has not reviewed libcurl ${ChronosDB_CURL_VERSION}")
  return()
endif()
find_dependency(OpenSSL 3.0...<4.0 COMPONENTS Crypto SSL)
find_dependency(zstd 1.5.5...<2.0 CONFIG)
if(@CHRONOS_ENABLE_ARROW_INTEROP@)
  find_dependency(Arrow CONFIG)
  find_dependency(Parquet CONFIG)
  if(ARROW_VERSION VERSION_LESS 25.0 OR ARROW_VERSION VERSION_GREATER_EQUAL 26.0)
    set(ChronosDB_FOUND FALSE)
    set(ChronosDB_NOT_FOUND_MESSAGE "ChronosDB requires Apache Arrow 25.x")
    return()
  endif()
  if(PARQUET_VERSION VERSION_LESS 25.0 OR PARQUET_VERSION VERSION_GREATER_EQUAL 26.0)
    set(ChronosDB_FOUND FALSE)
    set(ChronosDB_NOT_FOUND_MESSAGE "ChronosDB requires Apache Parquet 25.x")
    return()
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ChronosTargets.cmake")

check_required_components(ChronosDB)
