{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CHRONOS_BUILD_TESTS": "ON",
        "CHRONOS_BUILD_BENCHMARKS": "OFF",
        "CHRONOS_BUILD_FUZZERS": "OFF",
        "CHRONOS_ENABLE_ASAN": "OFF",
        "CHRONOS_ENABLE_UBSAN": "OFF",
        "CHRONOS_ENABLE_TSAN": "OFF",
        "CHRONOS_ENABLE_CLANG_TIDY": "OFF",
        "CHRONOS_WARNINGS_AS_ERRORS": "OFF"
      }
    },
    {
      "name": "dev",
      "displayName": "Developer Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "benchmark",
      "displayName": "Release Microbenchmarks",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CHRONOS_BUILD_TESTS": "OFF",
        "CHRONOS_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "wal-benchmark",
      "displayName": "Release WAL Benchmark Harness",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CHRONOS_BUILD_TESTS": "OFF",
        "CHRONOS_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "flush-benchmark",
      "displayName": "Release Manifest Flush Benchmark Harness",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CHRONOS_BUILD_TESTS": "OFF",
        "CHRONOS_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "raft-benchmark",
      "displayName": "Release Raft Persistence Benchmark Harness",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CHRONOS_BUILD_TESTS": "OFF",
        "CHRONOS_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CHRONOS_ENABLE_ASAN": "ON",
        "CHRONOS_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CHRONOS_ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "Clang libFuzzer with AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CHRONOS_BUILD_TESTS": "OFF",
        "CHRONOS_BUILD_FUZZERS": "ON",
        "CHRONOS_ENABLE_ASAN": "ON",
        "CHRONOS_ENABLE_UBSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "benchmark", "configurePreset": "benchmark" },
    { "name": "wal-benchmark", "configurePreset": "wal-benchmark" },
    { "name": "flush-benchmark", "configurePreset": "flush-benchmark" },
    { "name": "raft-benchmark", "configurePreset": "raft-benchmark" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "fuzz", "configurePreset": "fuzz" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": { "outputOnFailure": true }
    }
  ]
}
